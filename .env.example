# 실행 모드: api | worker | all
APP_MODE=all
PORT=3000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=orderuser
DATABASE_PASSWORD=orderpass
DATABASE_NAME=orderdb

# Redis (BullMQ + 분산 락 + 멱등성 키)
REDIS_HOST=localhost
REDIS_PORT=6379

# 서킷 브레이커
CB_FAILURE_THRESHOLD=5
CB_OPEN_DURATION_MS=30000

# 재시도 정책
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000

# 알림 (Slack)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_ALERT_CHANNEL=#order-failures

# 분산 락 TTL (초)
LOCK_TTL_SECONDS=60

# 멱등성 키 TTL (초, 기본 24시간)
IDEMPOTENCY_TTL_SECONDS=86400
