{
  "family": "order-system-api-staging",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/order-system-staging-ExecutionRole",
  "taskRoleArn":      "arn:aws:iam::ACCOUNT_ID:role/order-system-staging-TaskRole",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/chicken-order-system:staging",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "APP_MODE",              "value": "api" },
        { "name": "PORT",                  "value": "3000" },
        { "name": "NODE_ENV",              "value": "production" },
        { "name": "DATABASE_NAME",         "value": "orderdb" },
        { "name": "DB_POOL_MAX",           "value": "5" },
        { "name": "CB_FAILURE_THRESHOLD",  "value": "5" },
        { "name": "CB_OPEN_DURATION_MS",   "value": "30000" },
        { "name": "MAX_RETRY_ATTEMPTS",    "value": "3" },
        { "name": "RETRY_BASE_DELAY_MS",   "value": "1000" },
        { "name": "LOCK_TTL_SECONDS",      "value": "60" },
        { "name": "IDEMPOTENCY_TTL_SECONDS", "value": "86400" }
      ],
      "secrets": [
        { "name": "DATABASE_HOST",     "valueFrom": "/order-system/staging/db:host::" },
        { "name": "DATABASE_PORT",     "valueFrom": "/order-system/staging/db:port::" },
        { "name": "DATABASE_USER",     "valueFrom": "/order-system/staging/db:username::" },
        { "name": "DATABASE_PASSWORD", "valueFrom": "/order-system/staging/db:password::" },
        { "name": "REDIS_HOST",        "valueFrom": "/order-system/staging/redis:endpoint::" }
      ],
      "stopTimeout": 90,
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:3000/admin/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":  "/order-system/staging/api",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
