{
  "family": "order-system-api-production",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::610628048855:role/OrderSystem-Prod-ECS-ExecutionRole605A040B-8Vq6D2cPjI4r",
  "taskRoleArn":      "arn:aws:iam::610628048855:role/OrderSystem-Prod-ECS-TaskRole30FC0FBB-GvwVyhTyjWVm",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "610628048855.dkr.ecr.ap-northeast-2.amazonaws.com/chicken-order-system:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "APP_MODE",              "value": "api" },
        { "name": "PORT",                  "value": "3000" },
        { "name": "NODE_ENV",              "value": "production" },
        { "name": "DATABASE_NAME",         "value": "orderdb" },
        { "name": "DB_POOL_MAX",           "value": "30" },
        { "name": "CB_FAILURE_THRESHOLD",  "value": "5" },
        { "name": "CB_OPEN_DURATION_MS",   "value": "30000" },
        { "name": "MAX_RETRY_ATTEMPTS",    "value": "3" },
        { "name": "RETRY_BASE_DELAY_MS",   "value": "1000" },
        { "name": "LOCK_TTL_SECONDS",      "value": "60" },
        { "name": "IDEMPOTENCY_TTL_SECONDS", "value": "86400" },
        { "name": "REDIS_HOST",              "value": "master.orr1lp1tae0wbd2q.nhdrbw.apn2.cache.amazonaws.com" },
        { "name": "REDIS_PORT",              "value": "6379" },
        { "name": "ADMIN_BASE_URL",          "value": "http://order-production-1043936651.ap-northeast-2.elb.amazonaws.com" }
      ],
      "secrets": [
        { "name": "DATABASE_HOST",     "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:610628048855:secret:/order-system/production/db-YTBSpp:host::" },
        { "name": "DATABASE_PORT",     "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:610628048855:secret:/order-system/production/db-YTBSpp:port::" },
        { "name": "DATABASE_USER",     "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:610628048855:secret:/order-system/production/db-YTBSpp:username::" },
        { "name": "DATABASE_PASSWORD", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:610628048855:secret:/order-system/production/db-YTBSpp:password::" }
      ],
      "stopTimeout": 90,
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:3000/admin/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":  "/order-system/production/api",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
